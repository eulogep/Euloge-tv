# Public runtime config (safe to expose to the browser).
NEXT_PUBLIC_APP_NAME=MJTV
NEXT_PUBLIC_DEFAULT_COUNTRY=FR
NEXT_PUBLIC_DEFAULT_LANGUAGE=fra
NEXT_PUBLIC_ENABLE_DEBUG=false
NEXT_PUBLIC_ENABLE_EPG=false
NEXT_PUBLIC_ENABLE_CINEMATIC_CAROUSEL=true

# Server-only config (NOT exposed to the browser).
IPTV_DATA_REVALIDATE_SECONDS=21600

# Temporary fail-closed Admin V1 boundary. Server-only; use a password of at least 16 characters.
# Leave unset to make /admin return 404.
MJTV_ADMIN_USERNAME=
MJTV_ADMIN_PASSWORD=
